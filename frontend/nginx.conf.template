# SPA 配信 + /api/ のリバースプロキシ。
#
# nginx 公式イメージの envsubst 機構でコンテナ起動時に展開される
# (/etc/nginx/templates/*.template → /etc/nginx/conf.d/*)。
# 既定値は Dockerfile の ENV で与えているので、compose 側で何も指定しなくても
# 従来どおり http://api:8000 を向く。
#
# ⚠ upstream を直書き (proxy_pass http://api:8000;) に戻さないこと。
#   nginx は upstream 名を**起動時に一度だけ解決してキャッシュする**ため、api の
#   コンテナを作り直して IP が変わると、消えた IP に接続し続けて 502 を返し続ける。
#   復旧にはこのコンテナの再起動が要る。resolver + 変数経由なら毎リクエスト解決に
#   なり、api を作り直しても数秒で自動復旧する。

resolver ${WBS_RESOLVER} valid=10s ipv6=off;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # ⚠ 値にパスを含めないこと。`$upstream/` のように書くと location の /api/ が
        #   剥がれて api 側のルーティングが全部外れる。
        set $api_upstream http://${WBS_API_HOST}:${WBS_API_PORT};
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Android App Links の検証ファイル（ADR-0019）。中身は api が環境変数から作る。
    # ⚠ ここが無いと SPA の index.html（200・text/html）が返り、アプリへの戻りの検証が黙って落ちる。
    location = /.well-known/assetlinks.json {
        set $api_upstream http://${WBS_API_HOST}:${WBS_API_PORT};
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── PWA（task #192・ADR-0028）──────────────────────────────────────
    # ⚠ Service Worker・manifest・アイコンは認証の外（ここは静的に配るだけで、ログインを求めない）。
    #   sw.js を転送（302）で返すとブラウザは登録できず、ホーム画面に置けなくなる。
    # ⚠ 無いファイルに index.html を返さない（=404）。sw.js や assets に index.html（200）が返ると、
    #   Service Worker が HTML を JavaScript として殻に入れてしまう。
    # ⚠ sw.js・index.html・manifest は no-cache（毎回確かめる）。古いものが残ると新しい版に気付けない。
    #   ハッシュ付きの assets/ だけ長く持たせる。
    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /manifest.webmanifest {
        types { application/manifest+json webmanifest; }
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location /assets/ {
        try_files $uri =404;
        # always を付けない（404 を長く持たせない）
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
