# Serves the SPA + reverse proxy for /api/.
#
# Expanded at container start by the official nginx image's envsubst mechanism
# (/etc/nginx/templates/*.template → /etc/nginx/conf.d/*).
# Defaults are given by ENV in the Dockerfile, so even with nothing set in compose
# it points at http://api:8000 as before.
#
# ⚠ Do not go back to a hard-coded upstream (proxy_pass http://api:8000;).
#   nginx **resolves the upstream name once at startup and caches it**, so when the api
#   container is recreated and its IP changes, it keeps connecting to the gone IP and keeps returning 502.
#   Recovery needs a restart of this container. With resolver + a variable it resolves per request
#   and recovers automatically within seconds after the api is recreated.

resolver ${WBS_RESOLVER} valid=10s ipv6=off;

# Rate-limit only the pre-login endpoints per IP (nolumiatask #749; modeled on the front nginx in deploy-repo).
# ⚠ The key is CF-Connecting-IP set by Cloudflare, not $remote_addr. $remote_addr turns into the docker
#   gateway, so counting by it makes everyone share one limit. It cannot be spoofed from outside
#   (Cloudflare overwrites it). Requests coming directly from the home LAN lack this header and are not counted.
limit_req_zone $http_cf_connecting_ip zone=auth_ip:1m rate=10r/m;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # SSO start. Each call writes one row to the DB, so up to 10 per minute per IP.
    # A burst passes up to 11 calls, then gets an immediate 429; one slot returns every 6 seconds.
    # ⚠ Because of the trailing `$`, differently spelled paths do not land here.
    location ~ ^/api/auth/login$ {
        limit_req zone=auth_ip burst=10 nodelay;
        limit_req_status 429;

        set $api_upstream http://${WBS_API_HOST}:${WBS_API_PORT};
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        # ⚠ Do not include a path in the value. Writing it like `$upstream/` strips the location's /api/
        #   and breaks all routing on the api side.
        set $api_upstream http://${WBS_API_HOST}:${WBS_API_PORT};
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── PWA (task #192, ADR-0028) ──────────────────────────────────────
    # ⚠ The Service Worker, manifest and icons are outside auth (served statically here, no login required).
    #   If sw.js is answered with a redirect (302), the browser cannot register it and the app cannot be added to the home screen.
    # ⚠ Do not return index.html for missing files (=404). If index.html (200) is returned for sw.js or assets,
    #   the Service Worker puts HTML into the shell as JavaScript.
    # ⚠ sw.js, index.html and the manifest are no-cache (revalidated every time). If stale copies remain, new versions go unnoticed.
    #   Only hashed assets/ are cached long.
    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /manifest.webmanifest {
        types { application/manifest+json webmanifest; }
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location /assets/ {
        try_files $uri =404;
        # No `always` (do not cache 404s long)
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
