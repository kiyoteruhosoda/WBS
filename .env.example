# =============================================================================
# WBS environment variable template (for local docker compose)
#   cp .env.example .env and set the values. .env is not tracked by Git (already in .gitignore).
#   Even without .env it starts with development defaults via ${VAR:-default}
#   in docker-compose.yml. Always override them in publicly exposed environments.
#
#   For stg / prod deploys, the deploy bundle's scripts/deploy.sh generates the .env
#   template at the destination instead of this file (the key is
#   WEB_HOST_PORT, not WEB_PORT; see scripts/README.md for details).
# =============================================================================

# --- Image tag ----------------------------------------------------------------
# Image tag used by docker compose build / up (wbs-api:<tag> / wbs-web:<tag>).
APP_VERSION=local

# --- Host ports ---------------------------------------------------------------
# External listening port (web/nginx; the API is reached via the /api/ proxy).
WEB_PORT=8100
# Development port for calling the API directly (Swagger UI: http://127.0.0.1:8000/docs).
API_PORT=8000
# Host-side port of MariaDB.
DB_PORT=3306

# --- API ----------------------------------------------------------------------
# Default is SQLite (in the api-data volume). To use MariaDB, set it as below.
DATABASE_URL=sqlite:////app/data/app.db
# DATABASE_URL=mysql+pymysql://wbs:wbspass@db:3306/task_scheduler?charset=utf8mb4

# Initial admin. The defaults are for development, so always change them when exposed publicly.
ADMIN_EMAIL=local@example.com
ADMIN_PASSWORD=change-me-strong

# Container startup mode (app: normal start / migrate: schema sync only / reset: destructive init).
APP_MODE=app

# --- Auth / SSO ---------------------------------------------------------------
# single_user: no auth. Every request is treated as the single initial user (default, legacy behavior).
# oidc:        SSO via an IdP. Use this for deployments exposed over the network.
AUTH_MODE=single_user

# The following are used only when AUTH_MODE=oidc. issuer / client_id / redirect_uri are required;
# if missing, the app fails at startup (so a missing setting gets noticed).
#
# Example (Keycloak):
#   OIDC_ISSUER=https://idp.example.com/realms/wbs
# Example (Microsoft Entra ID):
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Example (Google Workspace):
#   OIDC_ISSUER=https://accounts.google.com
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
# Leave empty when registered as a public client (PKCE only).
#OIDC_CLIENT_SECRET=
# Register exactly the same value in the IdP's "allowed redirect URIs".
#OIDC_REDIRECT_URI=https://wbs.example.com/api/auth/callback
# Name shown on the sign-in screen button.
#OIDC_PROVIDER_NAME=SSO
# Requested scopes. Without email, membership cannot be determined.
#OIDC_SCOPES=openid email profile
# Timeout (seconds) for HTTP requests to the IdP.
#OIDC_HTTP_TIMEOUT_SECONDS=10

# Automatically create users on first sign-in (with false, only pre-registered people can get in).
#OIDC_AUTO_PROVISION=true
# Restrict allowed email domains (comma-separated). Always set this with a tenant-shared IdP.
#OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# Reject email addresses the IdP does not say are "verified".
#OIDC_REQUIRE_VERIFIED_EMAIL=true
# Merge people without a link into an existing user with the same email address (ADR-0004).
# ⚠ Default is not to merge, because email_verified is no proof of identity.
# ⚠ Set true only while carrying over existing users after adding SSO later, and revert once the migration is done.
#OIDC_LINK_BY_EMAIL=false

# Client identity when **we** query the IdP (periodic reconciliation; ADR-0003).
# ⚠ A separate registration from the sign-in client; the method is always private_key_jwt.
# ⚠ Empty means no periodic reconciliation (= people suspended at the IdP are not picked up hourly).
# ⚠ The roster API returns 403 until the service account is bound to the app on the IdP side.
#MACHINE_CLIENT_ID=wbs-machine
#MACHINE_PRIVATE_KEY_FILE=/srv/secrets/oidc/machine.key
# Only when multiple keys are registered.
#MACHINE_PRIVATE_KEY_KID=

# Endpoints where another app's server (Tracker) reads and writes on behalf of the user (ADR-0056).
# This app's audience (assay resource, e.g. api://wbs) and the machine client_ids allowed to read/write (comma-separated).
# If either is empty, no machine requests are let through.
#MACHINE_AUDIENCE=
#MACHINE_READER_CLIENT_IDS=

# Sign-in token lifetime and cookie handling (ADR-0069).
# Access token lifetime. ⚠ This value is exactly the upper bound on "how long until a suspension takes effect".
#ACCESS_TOKEN_EXPIRES_SECONDS=300
# Token signing key (32+ characters; required with AUTH_MODE=oidc). ⚠ In production pass it by location, not by value.
# ⚠ Changing the key makes everyone sign in once more. How to generate it: docs/OPERATIONS.md.
#SESSION_SIGNING_KEY_FILE=/run/session/signing-key
#AUTH_COOKIE_NAME=wbs_access_token
# Set to false only in development environments without https.
#AUTH_COOKIE_SECURE=true
#AUTH_COOKIE_SAMESITE=lax
# Where to return after logging out at the IdP.
#AUTH_POST_LOGOUT_REDIRECT_URI=https://wbs.example.com/login

# --- Database (MariaDB container) ---------------------------------------------
MARIADB_ROOT_PASSWORD=strong-mariadb-root-password-here
MARIADB_USER=wbs
MARIADB_PASSWORD=strong-mariadb-wbs-password-here
MARIADB_DATABASE=task_scheduler
