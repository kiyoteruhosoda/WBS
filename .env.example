# =============================================================================
# WBS 環境変数テンプレート（ローカル docker compose 用）
#   cp .env.example .env して値を設定する。.env は Git 管理外（.gitignore 済み）。
#   .env が無くても docker-compose.yml の ${VAR:-default} により開発向け既定値で
#   起動する。外部公開する環境では必ず上書きすること。
#
#   stg / prod へのデプロイでは、このファイルではなく deploy bundle の
#   scripts/deploy.sh が配置先に .env テンプレートを自動生成する（キーは
#   WEB_PORT ではなく WEB_HOST_PORT。詳細は scripts/README.md）。
# =============================================================================

# --- イメージタグ -------------------------------------------------------------
# docker compose build / up で使うイメージタグ（wbs-api:<tag> / wbs-web:<tag>）。
APP_VERSION=local

# --- ホスト側ポート -----------------------------------------------------------
# 外部からの待受ポート（web/nginx。API へは /api/ プロキシ経由で到達する）。
WEB_PORT=8100
# API を直接叩く開発用ポート（Swagger UI: http://127.0.0.1:8000/docs）。
API_PORT=8000
# MariaDB のホスト側ポート。
DB_PORT=3306

# --- API ----------------------------------------------------------------------
# 既定は SQLite（api-data ボリューム内）。MariaDB を使う場合は下記のように指定。
DATABASE_URL=sqlite:////app/data/app.db
# DATABASE_URL=mysql+pymysql://wbs:wbspass@db:3306/task_scheduler?charset=utf8mb4

# 初期管理者。既定値は開発向けなので外部公開時は必ず変更する。
ADMIN_EMAIL=local@example.com
ADMIN_PASSWORD=change-me-strong

# コンテナ起動モード（app: 通常起動 / migrate: スキーマ同期のみ / reset: 破壊的初期化）。
APP_MODE=app

# --- 認証 / SSO ---------------------------------------------------------------
# single_user: 認証なし。全リクエストが初期ユーザー 1 人として扱われる（既定・従来動作）。
# oidc:        IdP による SSO。ネットワーク越しに公開する配備ではこちらにする。
AUTH_MODE=single_user

# 以下は AUTH_MODE=oidc のときだけ使う。issuer / client_id / redirect_uri は必須で、
# 欠けているとアプリは起動時に落ちる（設定漏れに気づけるように）。
#
# 例（Keycloak）:
#   OIDC_ISSUER=https://idp.example.com/realms/wbs
# 例（Microsoft Entra ID）:
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# 例（Google Workspace）:
#   OIDC_ISSUER=https://accounts.google.com
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
# public client（PKCE のみ）で登録した場合は空のままでよい。
#OIDC_CLIENT_SECRET=
# IdP 側の「許可するリダイレクト URI」に一字一句同じものを登録する。
#OIDC_REDIRECT_URI=https://wbs.example.com/api/auth/callback
# ログイン画面のボタンに出す名前。
#OIDC_PROVIDER_NAME=SSO
# 要求するスコープ。email が無いと所属の判定ができない。
#OIDC_SCOPES=openid email profile
# IdP への HTTP 要求のタイムアウト（秒）。
#OIDC_HTTP_TIMEOUT_SECONDS=10

# 初回ログインの利用者を自動で作る（false にすると、あらかじめ登録した人だけが入れる）。
#OIDC_AUTO_PROVISION=true
# 入れるメールドメインの絞り込み（カンマ区切り）。テナント共用の IdP では必ず設定する。
#OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# IdP が「検証済み」と言わないメールアドレスを弾く。
#OIDC_REQUIRE_VERIFIED_EMAIL=true

# セッション（ログイン状態）の寿命と Cookie の扱い。
#AUTH_SESSION_TTL_HOURS=12
#AUTH_COOKIE_NAME=wbs_session
# https でない開発環境でだけ false にする。
#AUTH_COOKIE_SECURE=true
#AUTH_COOKIE_SAMESITE=lax
# IdP からログアウト後に戻す先。
#AUTH_POST_LOGOUT_REDIRECT_URI=https://wbs.example.com/login

# --- Database（MariaDB コンテナ）----------------------------------------------
MARIADB_ROOT_PASSWORD=strong-mariadb-root-password-here
MARIADB_USER=wbs
MARIADB_PASSWORD=strong-mariadb-wbs-password-here
MARIADB_DATABASE=task_scheduler
